{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "landing.schema.json",
  "title": "Landing Page Content Spec",
  "description": "랜딩페이지 한 장의 모든 내용을 담는 단일 파일. AI가 이 스펙에 맞춰 landing.json 을 채우면 kit/build.py 가 index.html 을 만든다. sections 배열의 순서가 곧 화면의 위에서 아래 순서다.",
  "type": "object",
  "required": [
    "meta",
    "theme",
    "brand",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60,
          "description": "브라우저 탭 · 검색결과 제목. '서비스명 — 한 줄 가치' 형태"
        },
        "description": {
          "type": "string",
          "maxLength": 160,
          "description": "메타 설명. 검색결과와 카톡 공유 미리보기에 뜨는 두 번째 줄"
        },
        "slug": {
          "type": "string",
          "description": "출력 파일 이름에 쓸 프로젝트명. 결과물은 <slug>_landingPage.html 이 된다. 생략하면 landing.json 이 놓인 폴더 이름을 쓴다."
        },
        "lang": {
          "type": "string",
          "enum": [
            "ko",
            "en"
          ],
          "default": "ko"
        },
        "favicon": {
          "type": "string",
          "description": "이모지 1개 권장. 예 '🚀'"
        },
        "ogImage": {
          "type": "string",
          "description": "공유 썸네일 이미지 경로. 없으면 생략"
        },
        "canonical": {
          "type": "string",
          "description": "배포될 실제 URL. 모르면 생략"
        }
      }
    },
    "theme": {
      "type": "string",
      "description": "kit/themes.json 의 테마 id. 기본 제공: midnight | sand | forest | violet. 브랜드 색이 따로 있으면 themes.json 에 새 항목을 추가하고 그 id 를 써도 된다. 일부 색만 바꿀 거면 themeOverrides 를 쓰는 편이 간단하다.",
      "examples": [
        "midnight",
        "sand",
        "forest",
        "violet"
      ]
    },
    "themeOverrides": {
      "type": "object",
      "description": "고른 팔레트 위에 개별 색만 덮어쓴다. 18개 토큰 중 필요한 것만 적으면 된다. 자주 쓰는 것: primary(주 버튼·강조), accent(보조 강조), hero-bg(첫 화면 배경). 다크 모드 값은 dark 쪽에 따로 적는다. 예: {\"tokens\": {\"primary\": \"#0055ff\"}, \"dark\": {\"primary\": \"#7a9dff\"}}",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "darkMode": {
          "type": "string",
          "enum": [
            "auto",
            "light-only",
            "dark-only"
          ],
          "default": "auto",
          "description": "auto = 방문자 시스템 설정 따라감 + 우상단 토글 버튼"
        },
        "radius": {
          "type": "string",
          "enum": [
            "sharp",
            "soft",
            "round"
          ],
          "default": "soft"
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "normal",
            "airy"
          ],
          "default": "normal",
          "description": "섹션 상하 여백"
        },
        "animate": {
          "type": "boolean",
          "default": true,
          "description": "스크롤 진입 페이드업. 방문자가 모션 최소화 설정이면 자동으로 꺼짐"
        }
      }
    },
    "brand": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "서비스/팀 이름"
        },
        "logo": {
          "type": "string",
          "description": "로고 이미지 경로. 없으면 이름이 텍스트로 표시됨"
        },
        "contactEmail": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "socials": {
          "type": "array",
          "description": "푸터 링크",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "description": "각 type 의 상세 규칙과 items 필드는 kit/sections.md 참고",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "nav",
              "hero",
              "logos",
              "stats",
              "problem",
              "steps",
              "features",
              "showcase",
              "team",
              "testimonials",
              "pricing",
              "faq",
              "cta",
              "form",
              "footer"
            ]
          },
          "id": {
            "type": "string",
            "description": "앵커 링크용 id. 생략하면 type 이 id 가 됨"
          },
          "navLabel": {
            "type": "string",
            "description": "상단 메뉴에 이 섹션을 노출할 라벨. 없으면 메뉴에 안 나옴"
          },
          "eyebrow": {
            "type": "string",
            "description": "제목 위 작은 라벨. 예 '왜 필요한가'"
          },
          "heading": {
            "type": "string"
          },
          "subheading": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "문단. 줄바꿈은 \\n\\n"
          },
          "background": {
            "type": "string",
            "enum": [
              "base",
              "alt",
              "surface",
              "hero",
              "primary"
            ],
            "description": "섹션 배경. 이웃한 섹션끼리 같은 값이면 경계가 사라지니 번갈아 쓸 것"
          },
          "columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "카드 그리드 열 수. 생략하면 개수로 자동 결정"
          },
          "image": {
            "type": "string",
            "description": "hero / showcase 의 시각물"
          },
          "imageAlt": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "버튼 아래 작은 안심 문구. 예 '카드 등록 없이 무료 체험'"
          },
          "action": {
            "type": "string",
            "description": "form 의 전송 endpoint (Formspree, Google Form 등). 없으면 제출 시 안내만 표시"
          },
          "primaryCta": {
            "$ref": "#/definitions/cta"
          },
          "secondaryCta": {
            "$ref": "#/definitions/cta"
          },
          "items": {
            "type": "array",
            "description": "반복 요소. 어떤 필드를 쓰는지는 섹션 type 마다 다름 → kit/sections.md",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "description": "일반 카드는 제목. team 에서는 팀원 이름."
                },
                "body": {
                  "type": "string",
                  "description": "설명 문단. team 에서는 한 줄 소개."
                },
                "icon": {
                  "type": "string",
                  "description": "이모지 1개"
                },
                "image": {
                  "type": "string",
                  "description": "카드 이미지. team 에서는 얼굴 사진 (정사각형 권장, 없으면 이름 첫 글자가 대신 들어감)."
                },
                "value": {
                  "type": "string",
                  "description": "stats: 수치. 예 '1,200+'"
                },
                "label": {
                  "type": "string",
                  "description": "stats: 수치 설명 / logos: 회사·기관명 / team: 링크에 붙일 글자 (기본 '프로필 보기')"
                },
                "quote": {
                  "type": "string",
                  "description": "testimonials: 인용문"
                },
                "author": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "description": "testimonials: 후기 작성자 소속·직함 / team: 맡은 역할 (예 '백엔드 · 인프라')"
                },
                "price": {
                  "type": "string",
                  "description": "pricing: 예 '무료', '₩39,000'"
                },
                "period": {
                  "type": "string",
                  "description": "pricing: 예 '/월'"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "pricing: 포함 항목 목록"
                },
                "featured": {
                  "type": "boolean",
                  "description": "pricing: 강조할 플랜. 딱 1개만 true"
                },
                "cta": {
                  "$ref": "#/definitions/cta"
                },
                "q": {
                  "type": "string",
                  "description": "faq: 질문"
                },
                "a": {
                  "type": "string",
                  "description": "faq: 답변"
                },
                "name": {
                  "type": "string",
                  "description": "form: 입력 필드의 name 속성"
                },
                "fieldType": {
                  "type": "string",
                  "enum": [
                    "text",
                    "email",
                    "tel",
                    "textarea",
                    "select",
                    "checkbox"
                  ],
                  "description": "form 전용"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "form: select 선택지"
                },
                "required": {
                  "type": "boolean",
                  "description": "form: 필수 입력 여부"
                },
                "placeholder": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "링크 주소. team 에서는 깃허브·링크드인 등 프로필 주소."
                }
              }
            }
          },
          "video": {
            "type": "string",
            "description": "hero / showcase 에 넣을 데모 영상. 유튜브·비메오 링크를 그대로 붙여넣으면 임베드되고, .mp4 경로면 재생기가 들어간다. video 와 image 가 둘 다 있으면 video 가 우선한다."
          }
        }
      }
    }
  },
  "definitions": {
    "cta": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 24,
          "description": "동사로 시작하는 구체적 행동. '자세히 보기', '더 알아보기' 같은 라벨 금지"
        },
        "href": {
          "type": "string",
          "description": "'#섹션id' 또는 외부 URL"
        },
        "style": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "ghost"
          ],
          "default": "primary"
        },
        "newTab": {
          "type": "boolean"
        }
      }
    }
  }
}
